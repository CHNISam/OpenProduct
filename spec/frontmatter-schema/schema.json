{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "sourceOwner": "contract.md#s-012",
  "type": "object",
  "required": [
    "id",
    "type",
    "revision",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "requestedTarget": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "criticality": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "realization": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "realizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "executionRefs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "Proposed",
              "Accepted",
              "Retired"
            ]
          },
          "executionRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    },
    "currentRealization": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetRevision": {
          "type": "integer",
          "minimum": 1
        },
        "outcomeRevision": {
          "type": "integer",
          "minimum": 1
        },
        "realization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    }
  },
  "defaults": {
    "status": "Draft",
    "relations": [],
    "labels": [],
    "sourceRefs": []
  },
  "syntax": "JSON-form YAML 1.2 between exact --- delimiter lines; duplicate keys, non-finite numbers, non-JSON YAML constructs and non-UTF-8 input rejected. JSON string escapes are the multiline representation.",
  "unknownFields": "UNKNOWN_NORMATIVE_FIELD",
  "inverseRelationFields": [
    "requiredBy",
    "selectedBy",
    "supportedBy",
    "verifiedBy",
    "validatedBy"
  ]
}
